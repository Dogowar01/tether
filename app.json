{
  "expo": {
    "name": "Tether",
    "slug": "tether",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Tether.png",
    "scheme": "tether",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/Tether.png",
      "bundleIdentifier": "com.signal9.tether",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.signal9.tether",
      "adaptiveIcon": {
        "foregroundImage": "./assets/Tether.png",
        "backgroundColor": "#1C1917"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E1B28",
          "image": "./assets/Tether.png",
          "imageWidth": 120
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "ios": {
            "privacyManifests": {
              "NSPrivacyTracking": false,
              "NSPrivacyTrackingDomains": [],
              "NSPrivacyCollectedDataTypes": [],
              "NSPrivacyAccessedAPITypes": [
                {
                  "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
                  "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
                },
                {
                  "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
                  "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
                },
                {
                  "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
                  "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
                },
                {
                  "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
                  "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
                }
              ]
            }
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/tether"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2bf7ed00-3d70-4694-b5f7-2563a8030ad0"
      }
    },
    "owner": "dogowar01"
  }
}
